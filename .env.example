# Postgres (Neon). Leave empty locally to use the built-in PGLite database.
DATABASE_URL=

# Any long random string, e.g. `openssl rand -hex 32`. Keep it the same between deploys.
BETTER_AUTH_SECRET=

# Public URL of the site (no trailing slash)
BETTER_AUTH_URL=http://localhost:8080

# Google sign-in (web). Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
